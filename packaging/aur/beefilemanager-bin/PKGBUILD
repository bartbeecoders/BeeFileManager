# Maintainer: BeeFileManager maintainers <https://github.com/bartbeecoders/BeeFileManager/issues>
# Generated from PKGBUILD.in; do not edit directly.

pkgname=beefilemanager-bin
pkgver=0.9.0
pkgrel=1
_releasever=0.9.0
pkgdesc="A fast, keyboard-first file manager for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/bartbeecoders/BeeFileManager"
license=('GPL-3.0-or-later')
depends=(
  'bubblewrap'
  'fontconfig'
  'glibc>=2.39'
  'gtk4>=4.12'
  'gtksourceview5'
  'poppler-glib'
)
optdepends=(
  'ffmpeg: video previews'
  'ffmpegthumbnailer: video thumbnails'
  'gst-libav: additional media format playback'
  'gst-plugins-good: media playback in previews'
  'gvfs-smb: SMB network locations'
  'imagemagick: RAW image previews'
  'libraw: RAW image previews when ImageMagick is unavailable'
)
provides=("beefilemanager=${pkgver}")
conflicts=('beefilemanager' 'beefilemanager-rc-bin')
# Preserve byte identity with the attested release artifact.
options=('!strip' '!debug')
source_x86_64=("${url}/releases/download/v${_releasever}/beefilemanager-${_releasever}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("${url}/releases/download/v${_releasever}/beefilemanager-${_releasever}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('708ff61000ae78790813c4e842ab6d7b49be6d85a728d22e1ff59cc34f54599d')
sha256sums_aarch64=('361be021c83bdf8af503ac8c487f3e1e6b2900211dcaef237fd8c9b699277713')

package() {
  local dist="${srcdir}/beefilemanager-${_releasever}-${CARCH}-unknown-linux-gnu"

  install -Dm755 "${dist}/beefilemanager" "${pkgdir}/usr/bin/beefilemanager"
  install -Dm644 "${dist}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dist}/THIRD_PARTY_LICENSES.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_LICENSES.md"

  if [[ -f "${dist}/io.github.bartbeecoders.BeeFileManager.desktop" ]]; then
    install -Dm644 "${dist}/io.github.bartbeecoders.BeeFileManager.desktop" \
      "${pkgdir}/usr/share/applications/io.github.bartbeecoders.BeeFileManager.desktop"
    install -Dm644 "${dist}/io.github.bartbeecoders.BeeFileManager.svg" \
      "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.github.bartbeecoders.BeeFileManager.svg"
  else
    warning "BeeFileManager ${_releasever} ships no desktop entry or application icon; installing without a launcher."
  fi

  if [[ -f "${dist}/io.github.bartbeecoders.BeeFileManager.FileManager1.service" ]]; then
    install -Dm644 "${dist}/io.github.bartbeecoders.BeeFileManager.FileManager1.service" \
      "${pkgdir}/usr/share/beefilemanager/io.github.bartbeecoders.BeeFileManager.FileManager1.service"
  fi

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/beefilemanager/install-source.toml" <<'MARKER'
manager = "pacman"
package = "beefilemanager-bin"
channel = "stable"
aur_helpers = ["yay", "paru", "pikaur", "trizen"]
alternate_package = "beefilemanager-rc-bin"
MARKER
}
